# Base URL backend DesaNyala (tanpa trailing slash).
# Kosongkan untuk otomatis memakai mock API.
NEXT_PUBLIC_BASE_API_URL=

# "true" untuk memaksa mock API walau base URL terisi.
NEXT_PUBLIC_USE_MOCK_API=true

# Hasil mock solver: auto | success | fail
# auto = gagal (infeasible) bila kapasitas diesel < beban puncak dan
#        batas beban tak terlayani = 0, selain itu sukses.
NEXT_PUBLIC_MOCK_SOLVER_RESULT=auto
