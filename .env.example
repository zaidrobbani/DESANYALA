# Base URL backend DesaNyala (tanpa trailing slash), mis.
# https://desa-nyala-backend.vercel.app
# Kosongkan untuk otomatis memakai mock API.
NEXT_PUBLIC_BASE_API_URL=https://desa-nyala-backend.vercel.app

# Sumber hasil optimasi:
#   auto    = coba backend; bila backend error (engine/5xx/jaringan/timeout)
#             run itu otomatis memakai mock FE tanpa pemberitahuan di UI
#             (sumber run tetap tercatat di sessionStorage untuk debugging)
#   backend = selalu backend, error ditampilkan apa adanya
#   mock    = selalu mock FE, backend tidak dipanggil
# Base URL kosong selalu berarti mock.
NEXT_PUBLIC_API_MODE=auto

# Hasil mock solver (mode mock & fallback):
#   auto         = diesel-only infeasible bila kapasitas genset < total daya
#                  terpasang peralatan dan kekurangan listrik tidak diizinkan
#   success      = semua skenario optimal
#   fail         = semua skenario infeasible
#   fail-partial = skenario terakhir infeasible, sisanya optimal
#   error        = backend menolak request (HTTP 422 engine_error)
NEXT_PUBLIC_MOCK_SOLVER_RESULT=auto

# Batas waktu POST /api/v1/optimizations (ms). Engine menjalankan semua
# skenario dalam satu request, jadi bisa lama untuk 365 hari.
NEXT_PUBLIC_OPTIMIZATION_TIMEOUT_MS=900000
